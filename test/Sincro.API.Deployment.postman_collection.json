{
  "info": {
    "name": "Sincro API Deployment Checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion de verificacion de despliegue del backend Sincro con JWT."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:13001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth - Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin@sincro.local\",\n  \"password\": \"AdminPass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 2xx en login', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Login devuelve success=true', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "});",
              "pm.test('Login devuelve accessToken', function () {",
              "  pm.expect(json.data).to.be.an('object');",
              "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('token', json.data.accessToken);",
              "pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "pm.environment.set('accessToken', json.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Auth - Me",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
