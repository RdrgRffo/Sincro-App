# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL FRONTEND (Vite)
# -----------------------------------------------------------------------------
# URL base para las peticiones a la API del Backend.
# En Docker: el proxy de Vite redirige automáticamente a http://backend:13001
# En local sin Docker: cámbiala a la URL de tu backend (ej: http://localhost:3001)
VITE_API_URL="http://localhost:13001"
